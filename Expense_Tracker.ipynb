      "source": [
        "def add_expense():\n",
        "  ad={\"date\":input(\"Enter date:\"),\n",
        "       \"category\":input(\"Enter category:\"),\n",
        "        \"Description\":input(\"Enter Description:\"),\n",
        "         \"Amount\":int(input(\"Enter amount: \"))}\n",
        "  my_exp.append(ad)\n",
        "  print(\"Expense added\")\n",
        "def view_expenses():\n",
        "  for i in my_exp:\n",
        "     print(f\"Date:{i[\'date\']}\\nCategory: {i[\'category\']}\\nDescription:{i[\'Description\']}\\nAmount:{i[\'Amount\']}\")\n",
        "def search_expenses():\n",
        "  a=input(\"Enter the expense to search:\")\n",
        "  b=True\n",
        "  for i in my_exp:\n",
        "    if i[\"category\"] == a:\n",
        "      print(f\"Date:{i[\'date\']}\\nCategory: {i[\'category\']}\\nDescription:{i[\'Description\']}\\nAmount:{i[\'Amount\,]}\")\n",
        "      b=False\n",
        "  if b:\n",
        "      print(\"No Expense Found\")\n",
        "def calculate_total():\n",
        "  total=0\n",
        "  for i in my_exp:\n",
        "    total+=i[\"Amount\"]\n",
        "  print(\"Total Expense:\",total)\n",
        "def category_summary():\n",
        " summary={}\n",
        " for i in my_exp:\n",
        "  if i[\"category\"] in summary:\n",
        "    summary[i[\"category\"]]+=i[\"Amount\"]\n",
        "  else:\n",
        "      summary[i[\"category\"]]=i[\"Amount\"]\n",
        " for i in summary:\n",
        "  print(i,summary[i])\n",
        "my_exp=[]\n",
        "while True:\n",
        "  i=int(input(\"Enter the Choice of Expense: \"))\n",
        "  if(i==1):\n",
        "    add_expense()\n",
        "  elif (i==2):\n",
        "    view_expenses()\n",
        "  elif (i==3):\n",
        "    search_expenses()\n",
        "  elif (i==4):\n",
        "    calculate_total()\n",
        "  elif (i==5):\n",
        "    category_summary()\n",
        "  elif (i==6):\n",
        "      break\n",
        "  else:\n",
        "    print(\"Enter Valid Choice!\")"
      ],
